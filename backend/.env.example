# ---------------------------------------------------------------------------
# Dunk AI backend. Copy to .env and fill in. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/dunkai
MONGODB_DB_NAME=
# Atlas-only fallback when a hotspot/ISP refuses SRV or TXT DNS lookups.
# Uses DNS over HTTPS, retaining TLS and credentials. Development defaults to
# true; production/test default to false. Disable for private Atlas endpoints.
MONGODB_DNS_FALLBACK=true

# Auth (required in production)
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
BCRYPT_ROUNDS=12

# Encrypts users' own API keys (BYOK) at rest. Required in production.
# Changing it makes stored keys unreadable; users would re-enter them.
BYOK_ENCRYPTION_KEY=

# Cookies. Leave COOKIE_DOMAIN empty unless auth must span subdomains.
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Frontend origin(s). FRONTEND_URL is used for redirects (OAuth, emails).
# CORS_ORIGINS adds more allowed origins, comma-separated (preview deploys).
FRONTEND_URL=http://localhost:3000
CLIENT_ORIGIN=http://localhost:3000
CORS_ORIGINS=

# Proxy hops in front of this server (load balancer, Next.js rewrite).
# Defaults to 1 in production. Needed for per-IP rate limiting.
TRUST_PROXY=

# Optional: override DNS resolvers (e.g. 8.8.8.8,1.1.1.1) when mongodb+srv
# lookups fail on a local network. Leave empty on hosts and in Docker.
DNS_SERVERS=

# Google OAuth. Point the redirect at the FRONTEND origin's /api rewrite in
# production, so the auth cookies are set on the frontend's domain:
#   https://app.example.com/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# AI engine (Python supervisor). Use the same token on both services.
SUPERVISOR_AGENT_URL=http://127.0.0.1:8000
SUPERVISOR_AGENT_PATH=/api/v1/supervisor
SUPERVISOR_AGENT_TOKEN=

# Browser runtime. Use with a frontend built with
# NEXT_PUBLIC_BROWSER_COMPUTE_ONLY=true. This disables Python AI routes.
# GROQ_API_KEY stays on this Node backend; BYOK Groq keys remain encrypted here.
# The five monthly hosted requests are metered even when Stripe is disabled.
# Atlas replica-set transactions are required. No Python/Redis/worker needed.
BROWSER_COMPUTE_ONLY=true
GROQ_API_KEY=
GROQ_BROWSER_MODEL=openai/gpt-oss-120b

# Billing. Keep off until MongoDB replica-set transactions and Stripe test mode
# checkout/webhook have passed. Self-hosted installs can leave it off.
BILLING_ENABLED=false
# Temporarily bypass credit/quota checks for local development only.
# Ignored outside NODE_ENV=development. Leave false on hosted deployments.
DISABLE_CREDITS_FOR_TESTING=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
AI_QUEUE_ENABLED=false
REDIS_URL=

# File uploads. Mount a persistent volume here when hosted.
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25

# Cloudinary (optional)
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# SMTP is required for local registration, verification, and password reset in production.
EMAIL_FROM=noreply@dunkai.io
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
RESET_TOKEN_EXPIRY_MIN=30
