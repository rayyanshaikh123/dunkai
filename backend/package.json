{
  "name": "dunk-ai-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "start:worker": "node src/worker.js",
    "check": "node --check src/server.js && node --check src/app.js",
    "test:credit-config": "node --test test/credit-testing-config.test.js",
    "test:database-dns": "node --test test/mongo-dns.test.js",
    "test:google-auth": "NODE_ENV=test GOOGLE_CLIENT_ID=google-auth-test-client GOOGLE_CLIENT_SECRET=google-auth-test-secret FRONTEND_URL=https://dunkai.vercel.app GOOGLE_REDIRECT_URI=https://dunkai.onrender.com/api/v1/auth/google/callback node --test test/google-auth.test.js",
    "test:credits": "DISABLE_CREDITS_FOR_TESTING=false LOCAL_RUNTIME_ENABLED=false BILLING_ENABLED=true STRIPE_SECRET_KEY=sk_test_dummy STRIPE_WEBHOOK_SECRET=whsec_dummy node --test test/credits.test.js",
    "lint": "eslint src/",
    "test:runtime": "DISABLE_CREDITS_FOR_TESTING=false LOCAL_RUNTIME_ENABLED=true BILLING_ENABLED=false GROQ_API_KEY=gsk_hosted_test BYOK_ENCRYPTION_KEY=runtime-test-key node --test test/runtime.test.js",
    "package:runtime": "node scripts/package-runtime.mjs",
    "test:free-designs": "DISABLE_CREDITS_FOR_TESTING=false LOCAL_RUNTIME_ENABLED=false CREDIT_METERING_ENABLED=true node --test test/free-designs.test.js"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.11",
    "cloudinary": "^2.6.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "google-auth-library": "^11.2.0",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.14",
    "proxy-addr": "^2.0.8",
    "socket.io": "^4.8.1",
    "stripe": "^23.0.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "eslint": "^9.18.0",
    "mongodb-memory-server": "^11.3.0"
  }
}
