# Dunk AI web app. Copy to frontend/.env.local.

# The backend as seen from the Next.js server; /api and /uploads are proxied
# here. Read at BUILD time for a standalone/Docker build.
BACKEND_URL=http://localhost:4000

# The backend as seen from the browser, for the Socket.io connection.
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Public URL of this site (Open Graph / canonical links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
