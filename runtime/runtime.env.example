# Node backend URL (not the frontend URL).
DUNKAI_BACKEND_URL=https://YOUR-BACKEND.onrender.com
DUNKAI_DEVICE_NAME=My computer
# Optional: your own Groq key. Leave blank to use DunkAI hosted inference.
# This file stays on this computer. Never upload or commit it.
DUNKAI_GROQ_API_KEY=
DUNKAI_GROQ_MODEL=openai/gpt-oss-120b
