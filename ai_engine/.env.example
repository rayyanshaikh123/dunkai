# ---------------------------------------------------------------------------
# Dunk AI engine (Python). Copy to ai_engine/.env and fill in.
# Users can bring their own Groq/Gemini/Anthropic keys (Settings → API keys);
# the keys below are the operator's, used when a user has not added one.
# ---------------------------------------------------------------------------

# Required: every pipeline agent runs on Groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Fallbacks when a model's daily limit is spent (comma-separated, "" disables).
GROQ_FALLBACK_MODELS=

# Required: read access to the component dataset on Hugging Face.
HF_TOKEN_READ=

# Same value as SUPERVISOR_AGENT_TOKEN on the backend. Without it the engine
# accepts unauthenticated requests — fine on localhost, never when exposed.
SUPERVISOR_AGENT_TOKEN=

# Server. Use 0.0.0.0 in a container. PORT (set by most hosts) wins.
SUPERVISOR_HOST=127.0.0.1
SUPERVISOR_PORT=8000

# Board generation (dunkai-designer).
#   claude-code — needs the `claude` CLI on this host (not in the Docker image)
#   groq | gemini | anthropic | ollama — need a key, here or the user's own
DESIGNER_PROVIDER=groq
DESIGNER_MODEL=
DUNKAI_DESIGNER_PATH=
# Where boards are written. Default: backend/uploads/boards in this repo.
# Separate hosts: any path whose last segment is `boards`; the backend
# proxies /uploads/boards/* here.
DESIGNER_OUTPUT_ROOT=
BOARD_SANDBOX_REQUIRED=false
BOARD_JOB_TIMEOUT_SECONDS=900

# Optional provider keys for board generation
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
OLLAMA_API_KEY=
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# Cache for the component dataset and embeddings (mount a volume when hosted).
DUNKAI_CACHE_DIR=

# Requirement agent tuning (optional)
REQUIREMENT_AGENT_TEMPERATURE=0.2
# Maximum follow-up questions for a sparse brief; detailed briefs cap at two.
REQUIREMENT_AGENT_MAX_TURNS=4
